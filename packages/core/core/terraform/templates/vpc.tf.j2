resource "google_compute_network" "{{ node.name }}" {
  name                            = "{{ gcp_name }}"
  auto_create_subnetworks         = {{ config.auto_create_subnetworks | lower }}
  routing_mode                    = "{{ config.routing_mode }}"
{% if config.description %}
  description                     = "{{ config.description }}"
{% endif %}
  mtu                             = {{ config.mtu }}
  delete_default_routes_on_create = {{ config.delete_default_routes_on_create | lower }}
{% if config.enable_ula_internal_ipv6 %}
  enable_ula_internal_ipv6        = true
{% endif %}
{% if config.internal_ipv6_range %}
  internal_ipv6_range             = "{{ config.internal_ipv6_range }}"
{% endif %}
{% if config.network_firewall_policy_enforcement_order != 'AFTER_CLASSIC_FIREWALL' %}
  network_firewall_policy_enforcement_order = "{{ config.network_firewall_policy_enforcement_order }}"
{% endif %}
  project                         = var.gcp_project_id
}
