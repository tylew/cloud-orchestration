resource "google_compute_global_address" "{{ node.name }}_ip" {
  name    = "{{ gcp_name }}-ip"
  project = var.gcp_project_id
}

{% if config.managed_ssl_certificate %}
resource "google_compute_managed_ssl_certificate" "{{ node.name }}_cert" {
  name    = "{{ gcp_name }}-cert"
  project = var.gcp_project_id
  managed {
    domains = {{ config.managed_ssl_certificate.domains | tojson }}
  }
}
{% endif %}

{% if config.default_backend %}
resource "google_compute_region_network_endpoint_group" "{{ node.name }}_neg" {
  name                  = "{{ gcp_name }}-neg"
  network_endpoint_type = "SERVERLESS"
  region                = var.gcp_region
  project               = var.gcp_project_id

{% if config.default_backend.cloud_run_service %}
  cloud_run {
    service = {{ resolve_ref(config.default_backend.cloud_run_service) if config.default_backend.cloud_run_service.startswith('node:') else '"' ~ config.default_backend.cloud_run_service ~ '"' }}
  }
{% endif %}
}
{% endif %}

resource "google_compute_backend_service" "{{ node.name }}_backend" {
  name                  = "{{ gcp_name }}-backend"
  protocol              = "HTTPS"
  load_balancing_scheme = "{{ config.scheme }}"
{% if config.security_policy %}
  security_policy       = "{{ config.security_policy }}"
{% endif %}
  project               = var.gcp_project_id

{% if config.default_backend %}
  backend {
    group = google_compute_region_network_endpoint_group.{{ node.name }}_neg.id
  }
{% endif %}

{% if config.cdn_policy %}
  cdn_policy {
    cache_mode = "{{ config.cdn_policy.cache_mode }}"
  }
{% endif %}

{% if config.logging %}
  log_config {
    enable      = {{ config.logging.enable | lower }}
    sample_rate = {{ config.logging.sample_rate }}
  }
{% endif %}
}

resource "google_compute_url_map" "{{ node.name }}_url_map" {
  name            = "{{ gcp_name }}-url-map"
  default_service = google_compute_backend_service.{{ node.name }}_backend.id
  project         = var.gcp_project_id
}

resource "google_compute_target_https_proxy" "{{ node.name }}_proxy" {
  name             = "{{ gcp_name }}-proxy"
  url_map          = google_compute_url_map.{{ node.name }}_url_map.id
{% if config.managed_ssl_certificate %}
  ssl_certificates = [google_compute_managed_ssl_certificate.{{ node.name }}_cert.id]
{% endif %}
  project          = var.gcp_project_id
}

resource "google_compute_global_forwarding_rule" "{{ node.name }}_fwd" {
  name                  = "{{ gcp_name }}-fwd"
  target                = google_compute_target_https_proxy.{{ node.name }}_proxy.id
  port_range            = "443"
  ip_address            = google_compute_global_address.{{ node.name }}_ip.address
  load_balancing_scheme = "{{ config.scheme }}"
  project               = var.gcp_project_id
}
