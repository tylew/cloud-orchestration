resource "google_service_account" "{{ tf_label }}" {
  account_id   = "{{ gcp_name }}"
  display_name = "{{ config.display_name or gcp_name }}"
{% if config.description %}
  description  = "{{ config.description }}"
{% endif %}
{% if config.disabled %}
  disabled     = true
{% endif %}
  project      = var.gcp_project_id
}

{% for binding in config.roles %}
resource "google_project_iam_member" "{{ tf_label }}_{{ loop.index0 }}" {
  project = var.gcp_project_id
  role    = "{{ binding.role }}"
  member  = "serviceAccount:${google_service_account.{{ tf_label }}.email}"
}

{% endfor %}
