resource "google_secret_manager_secret" "{{ node.name }}" {
  secret_id = "{{ gcp_name }}"
  project   = var.gcp_project_id

{% if config.labels %}
  labels = {
{% for k, v in config.labels.items() %}
    {{ k }} = "{{ v }}"
{% endfor %}
  }
{% endif %}

{% if config.annotations %}
  annotations = {
{% for k, v in config.annotations.items() %}
    {{ k }} = "{{ v }}"
{% endfor %}
  }
{% endif %}

{% if config.expire_time %}
  expire_time = "{{ config.expire_time }}"
{% endif %}
{% if config.ttl %}
  ttl = "{{ config.ttl }}"
{% endif %}

{% if config.version_aliases %}
  version_aliases = {
{% for alias, ver in config.version_aliases.items() %}
    {{ alias }} = "{{ ver }}"
{% endfor %}
  }
{% endif %}

{% if config.version_destroy_ttl %}
  version_destroy_ttl = "{{ config.version_destroy_ttl }}"
{% endif %}

{% if config.rotation_period %}
  rotation {
    rotation_period = "{{ config.rotation_period }}"
  }
{% endif %}

{% for topic in config.topics %}
  topics {
    name = "{{ topic.name }}"
  }
{% endfor %}

  replication {
{% if config.replication == 'user_managed' and config.replication_locations %}
    user_managed {
{% for loc in config.replication_locations %}
      replicas {
        location = "{{ loc }}"
      }
{% endfor %}
    }
{% else %}
    auto {}
{% endif %}
  }
}
