resource "google_dns_managed_zone" "{{ tf_label }}" {
  name          = "{{ gcp_name }}"
  dns_name      = "{{ config.dns_name if config.dns_name.endswith('.') else config.dns_name ~ '.' }}"
  description   = "{{ config.description or 'Managed by platform' }}"
  visibility    = "{{ config.visibility }}"
  project       = var.gcp_project_id
  force_destroy = {{ config.force_destroy | lower }}

{% if config.visibility == 'private' and config.networks %}
  private_visibility_config {
{% for network in config.networks %}
    networks {
      network_url = {{ network }}
    }
{% endfor %}
  }
{% endif %}

{% if config.dnssec_enabled %}
  dnssec_config {
    state = "on"
  }
{% endif %}

{% if config.cloud_logging_config and config.cloud_logging_config.enable_logging %}
  cloud_logging_config {
    enable_logging = true
  }
{% endif %}

{% if config.forwarding_config and config.forwarding_config.target_name_servers %}
  forwarding_config {
{% for ns in config.forwarding_config.target_name_servers %}
    target_name_servers {
{% if ns.ipv4_address %}
      ipv4_address    = "{{ ns.ipv4_address }}"
{% endif %}
{% if ns.ipv6_address %}
      ipv6_address    = "{{ ns.ipv6_address }}"
{% endif %}
{% if ns.forwarding_path %}
      forwarding_path = "{{ ns.forwarding_path }}"
{% endif %}
    }
{% endfor %}
  }
{% endif %}

{% if config.peering_config %}
  peering_config {
    target_network {
      network_url = {{ resolve_ref(config.peering_config.target_network.network_url) if config.peering_config.target_network.network_url.startswith('node:') else '"' ~ config.peering_config.target_network.network_url ~ '"' }}
    }
  }
{% endif %}

{% if config.labels %}
  labels = {
{% for key, value in config.labels.items() %}
    "{{ key }}" = "{{ value }}"
{% endfor %}
  }
{% endif %}
}

{% for record in config.records %}
resource "google_dns_record_set" "{{ tf_label }}_{{ record.name | replace('@', 'apex') | replace('.', '_') }}_{{ record.type | lower }}" {
  managed_zone = google_dns_managed_zone.{{ tf_label }}.name
  name         = {% if record.name == '@' %}google_dns_managed_zone.{{ tf_label }}.dns_name{% else %}"{{ record.name }}.${google_dns_managed_zone.{{ tf_label }}.dns_name}"{% endif %}

  type    = "{{ record.type }}"
  ttl     = {{ record.ttl }}
  project = var.gcp_project_id

{% if record.target and record.target.startswith('node:') %}
  rrdatas = [{{ resolve_ref(record.target) }}]
{% elif record.rrdatas %}
  rrdatas = {{ record.rrdatas | tojson }}
{% endif %}
}
{% endfor %}
