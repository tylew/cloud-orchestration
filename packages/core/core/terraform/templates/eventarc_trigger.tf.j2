resource "google_eventarc_trigger" "{{ node.name }}_trigger_{{ idx }}" {
  name     = "${var.environment}-{{ node.name }}-trigger-{{ idx }}"
  location = "{{ trigger.location or global_.region }}"
  project  = var.gcp_project_id

{% for mc in trigger.matching_criteria %}
  matching_criteria {
    attribute = "{{ mc.attribute }}"
    value     = "{{ mc.value }}"
{% if mc.operator %}
    operator  = "{{ mc.operator }}"
{% endif %}
  }
{% endfor %}

  destination {
    cloud_run_service {
      service = google_cloud_run_v2_service.{{ node.name }}.name
      region  = var.gcp_region
    }
  }

{% if trigger.transport and trigger.transport.pubsub_topic %}
  transport {
    pubsub {
      topic = {{ resolve_ref(trigger.transport.pubsub_topic) }}
    }
  }
{% endif %}

{% if trigger.service_account_email %}
  service_account = "{{ trigger.service_account_email }}"
{% endif %}
}
