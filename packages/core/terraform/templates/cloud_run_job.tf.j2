resource "google_cloud_run_v2_job" "{{ node.name }}" {
  name     = "${var.environment}-{{ node.name }}"
  location = var.gcp_region
  project  = var.gcp_project_id

{% if config.labels %}
  labels = {
{% for k, v in config.labels.items() %}
    {{ k }} = "{{ v }}"
{% endfor %}
  }
{% endif %}

  template {
    task_count  = {{ config.task_count }}
    parallelism = {{ config.parallelism }}

    template {
      service_account       = {{ resolve_ref(config.service_account) if config.service_account.startswith('node:') else '"' ~ config.service_account ~ '"' }}
      timeout               = "{{ config.timeout }}"
      max_retries           = {{ config.max_retries }}
      execution_environment = "{{ config.execution_environment }}"

{% if config.vpc_access and config.vpc_access.connector %}
      vpc_access {
        connector = {{ resolve_ref(config.vpc_access.connector) }}
        egress    = "{{ config.vpc_access.egress }}"
      }
{% endif %}

      containers {
        image = {{ resolve_ref(config.image) if config.image.startswith('node:') else '"' ~ config.image ~ '"' }}
{% if config.command %}
        command = {{ config.command | tojson }}
{% endif %}
{% if config.args %}
        args = {{ config.args | tojson }}
{% endif %}

        resources {
          limits = {
            cpu    = "{{ config.cpu }}"
            memory = "{{ config.memory }}"
          }
        }

{% for e in config.env_vars if e.type == "value" %}
        env {
          name  = "{{ e.name }}"
          value = "{{ e.value }}"
        }
{% endfor %}

{% for e in config.env_vars if e.type == "secret" %}
        env {
          name = "{{ e.name }}"
          value_source {
            secret_key_ref {
              secret  = {{ resolve_ref(e.secret) if e.secret.startswith('node:') else '"' ~ e.secret ~ '"' }}
              version = "{{ e.version }}"
            }
          }
        }
{% endfor %}
      }
    }
  }
}
